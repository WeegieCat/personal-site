{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "personalsite",
    "compatibility_date": "2026-09-02",
    // next build (output: "export") が生成した静的サイトをそのまま配信する。
    // Worker スクリプトは持たないため "main" は指定しない。
    "assets": {
        "directory": "./out",
        "not_found_handling": "404-page"
    }
}
